  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.0"
  }
