    "type": "git",
    "url": "git+https://github.com/tupkalov/telegramthread.git"
  },
  "scripts": {
    "test": "mocha 'test/**/*.test.mjs' --loader=./test/setup.mjs",
    "test:unit": "mocha 'test/unit/**/*.test.mjs' --loader=./test/setup.mjs",
    "test:integration": "mocha 'test/integration/**/*.test.mjs' --loader=./test/setup.mjs",
    "test:coverage": "c8 npm test",
    "test:watch": "mocha 'test/**/*.test.mjs' --loader=./test/setup.mjs --watch",
    "prepublishOnly": "npm run build",
    "build": "babel src --out-dir cjs"
  },
  "exports": {
    ".": {
